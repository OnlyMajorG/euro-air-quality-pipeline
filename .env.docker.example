# Konfiguration fuer den lokalen Docker-Compose-Stack.
# Wird vom Jupyter-Container automatisch geladen (siehe docker-compose.yml).

EXECUTION_ENV=docker_compose

# Spark-Cluster (Master + Worker teilen sich /workspace).
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_KAFKA_CONNECTOR_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.7

# Kafka-Broker (interner Listener) und Topic.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_AIR_QUALITY_LIVE=air_quality_live

# EEA-Rohdaten lokal in PostgreSQL.
EEA_BRONZE_STORAGE_MODE=postgres
POSTGRES_DSN=postgresql://euro_air_quality:euro_air_quality@postgres:5432/euro_air_quality

# EEA-Zeitraum (Standard: ein volles Jahr).
EEA_DATE_START=2025-01-01T00:00:00Z
EEA_DATE_END=2026-01-01T00:00:00Z

# Optional: EEA-Downloads-API-Endpunkt ueberschreiben (Default ist die offizielle URL im Notebook).
# Nur setzen, wenn ein abweichender Host / Mock / Proxy genutzt werden soll.
# EEA_DOWNLOADS_API_BASE_URL=https://eeadmz1-downloads-api-appservice.azurewebsites.net
