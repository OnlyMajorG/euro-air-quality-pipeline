EXECUTION_ENV=docker_compose_shared_storage
PROJECT_ROOT=/workspace
SPARK_LOCAL_HOSTNAME=jupyter
SPARK_MASTER_URL=spark://spark-master:7077
ALLOW_SHARED_SPARK_STORAGE=true
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_AIR_QUALITY_LIVE=LIVE-bdeng_docker_air_quality_live
KAFKA_MODE=kafka
ALLOW_KAFKA_MOCK_FALLBACK=false
SPARK_KAFKA_MODE=kafka
ALLOW_SPARK_KAFKA_MOCK_FALLBACK=false
SPARK_KAFKA_CONNECTOR_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.7
SPARK_SQL_SHUFFLE_PARTITIONS=1
RUN_PHASE7_SPARK_STORAGE_PROBE=true
KAFKA_CONSUMER_TIMEOUT_MS=10000
KAFKA_CONSUMER_MAX_MESSAGES=8
KAFKA_CONNECTION_TIMEOUT_SECONDS=5
KAFKA_OPERATION_TIMEOUT_MS=15000
RUN_OPEN_METEO_API_FETCH=true
ALLOW_CONTROLLED_OPEN_METEO_FALLBACK=true
RUN_OPEN_METEO_KAFKA_PRODUCER=true
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=20
OPEN_METEO_MAX_HOURS_TO_SEND=1
POSTGRES_DSN=postgresql://euro_air_quality:euro_air_quality@postgres:5432/euro_air_quality
EEA_DOWNLOADS_API_BASE_URL=https://eeadmz1-downloads-api-appservice.azurewebsites.net
EEA_BRONZE_STORAGE_MODE=postgres
EEA_RUN_API_FETCH=true
EEA_DATE_START=2025-01-01T00:00:00Z
EEA_DATE_END=2025-01-08T00:00:00Z
EEA_REQUEST_TIMEOUT_SECONDS=120
EEA_MAX_URLS_PER_CITY=0
MIN_FINAL_HISTORY_DAYS=365
DATA_DIR=data
CHECKPOINT_DIR=data/checkpoints
PROJECT_TIMEZONE=UTC
LOG_LEVEL=WARN
