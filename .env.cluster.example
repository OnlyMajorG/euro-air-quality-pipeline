EXECUTION_ENV=fh_cluster_shared_storage
SPARK_MASTER_URL=spark://<fh-spark-master-host>:7077
ALLOW_SHARED_SPARK_STORAGE=false
KAFKA_BOOTSTRAP_SERVERS=<fh-kafka-broker-host>:9092
KAFKA_TOPIC_AIR_QUALITY_LIVE=LIVE-bdeng_gXX_air_quality_live
KAFKA_MODE=kafka
ALLOW_KAFKA_MOCK_FALLBACK=false
SPARK_KAFKA_MODE=kafka
ALLOW_SPARK_KAFKA_MOCK_FALLBACK=false
SPARK_KAFKA_CONNECTOR_PACKAGE=
SPARK_SQL_SHUFFLE_PARTITIONS=8
RUN_PHASE7_SPARK_STORAGE_PROBE=true
KAFKA_CONSUMER_TIMEOUT_MS=10000
KAFKA_CONSUMER_MAX_MESSAGES=8
KAFKA_CONNECTION_TIMEOUT_SECONDS=5
KAFKA_OPERATION_TIMEOUT_MS=15000
RUN_OPEN_METEO_API_FETCH=true
ALLOW_CONTROLLED_OPEN_METEO_FALLBACK=false
RUN_OPEN_METEO_KAFKA_PRODUCER=true
OPEN_METEO_REQUEST_TIMEOUT_SECONDS=20
OPEN_METEO_MAX_HOURS_TO_SEND=1
EEA_BRONZE_STORAGE_MODE=parquet
EEA_RUN_API_FETCH=false
DATA_DIR=<confirmed_shared_storage_path>/euro-air-quality-pipeline/data
CHECKPOINT_DIR=<confirmed_shared_storage_path>/euro-air-quality-pipeline/checkpoints
