# Konfiguration fuer die FH-JupyterHub-Umgebung.
# Kopiere diese Datei nach .env und trage die FH-Werte ein.
# Die FH hat kein Docker und kein PostgreSQL -> EEA als Parquet, Spark lokal.

EXECUTION_ENV=fh_jupyterhub

# Spark laeuft im Notebook-Prozess; der Connector ist im FH-Kernel vorhanden.
SPARK_MASTER_URL=local[*]
SPARK_KAFKA_CONNECTOR_PACKAGE=

# FH-Kafka-Broker und gruppenspezifisches Topic (eigene Werte eintragen).
KAFKA_BOOTSTRAP_SERVERS=<fh-kafka-broker-host>:9092
KAFKA_TOPIC_AIR_QUALITY_LIVE=bdeng_gXX_air_quality_live

# EEA-Rohdaten ohne PostgreSQL als portables Parquet.
EEA_BRONZE_STORAGE_MODE=parquet

# EEA-Zeitraum (Standard: ein volles Jahr).
EEA_DATE_START=2025-01-01T00:00:00Z
EEA_DATE_END=2026-01-01T00:00:00Z
