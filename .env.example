# Vorlage fuer einen lokalen Lauf AUF DEM HOST gegen den Docker-Compose-Stack.
# Kopiere diese Datei nach .env. Adressen sind die veroeffentlichten Ports.
# Hinweis: Notebook 07 (Spark Streaming) im Docker-Jupyter unter http://localhost:8888 ausfuehren.

EXECUTION_ENV=docker_compose

SPARK_MASTER_URL=local[*]
SPARK_KAFKA_CONNECTOR_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.7

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_AIR_QUALITY_LIVE=air_quality_live

EEA_BRONZE_STORAGE_MODE=postgres
POSTGRES_DSN=postgresql://euro_air_quality:euro_air_quality@localhost:5432/euro_air_quality

EEA_DATE_START=2025-01-01T00:00:00Z
EEA_DATE_END=2026-01-01T00:00:00Z
